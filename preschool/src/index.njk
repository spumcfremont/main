<!-- ========== SCHEDULE A TOUR ========== -->
<section id="tour">
  <div class="wrap" style="max-width:640px">
    <div class="sechead">
      <p class="eyebrow"><span class="dot"></span>Come see us</p>
      <h2>Schedule a tour</h2>
      <p class="lede">We'd love to show you around. Tell us a bit about what you're looking for and a good time to visit, and we'll follow up to confirm.</p>
    </div>
    <form id="tour-form" method="POST"
      action="https://docs.google.com/forms/d/e/1FAIpQLScDEZOU7BAilajRkXjOZ9bHBGb3tPn5vUWdrDluyNLSYELsCw/formResponse">
      <div class="field-row">
        <div class="field">
          <label for="tf-name">Name</label>
          <input type="text" id="tf-name" name="entry.572477280" required>
        </div>
        <div class="field">
          <label for="tf-email">Email</label>
          <input type="email" id="tf-email" name="entry.1347231140" required>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="tf-phone">Phone</label>
          <input type="tel" id="tf-phone" name="entry.1569047645" required>
        </div>
        <div class="field">
          <label for="tf-date">Preferred date</label>
          <input type="date" id="tf-date" name="entry.644550688" required>
        </div>
      </div>
      <div class="field">
        <label for="tf-time">Preferred time</label>
        <select id="tf-time" name="entry.1174493635">
          <option value="Morning">Morning</option>
          <option value="Afternoon">Afternoon</option>
        </select>
      </div>
      <div class="field">
        <label for="tf-notes">Notes</label>
        <textarea id="tf-notes" name="entry.980133220" rows="4"></textarea>
      </div>
      <button type="submit" class="btn btn-solid">Request a tour</button>
    </form>
    <p id="tour-status" class="lede" style="margin-top:1rem;display:none"></p>
  </div>
</section>
<script>
(function(){
  var form=document.getElementById('tour-form');
  var status=document.getElementById('tour-status');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var data=new URLSearchParams(new FormData(form));
    fetch(form.action,{method:'POST',mode:'no-cors',body:data})
      .then(function(){
        form.reset();
        form.style.display='none';
        status.textContent='Thank you, we will get back to you at earliest convenience!';
        status.style.display='block';
      })
      .catch(function(){
        status.textContent='Something went wrong sending that. Please call (510) 429-3993 or email us directly.';
        status.style.display='block';
      });
  });
})();
</script>

