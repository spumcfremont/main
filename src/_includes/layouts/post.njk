---
layout: layouts/base.njk
---
<section class="reveal in">
  <div class="wrap" style="max-width:72ch">
    <div class="sechead">
      <p class="eyebrow">Pastor's Corner</p>
      <h2>{{ title }}</h2>
      <p class="contact" style="margin-top:.6rem">
        {{ author }} · <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      </p>
    </div>
    {% if image %}
    <img src="{{ image }}" alt="" style="border-radius:16px;box-shadow:var(--shadow);margin-bottom:2rem">
    {% endif %}
    <div class="lede" style="color:var(--ink)">
      {{ content | safe }}
    </div>
    <div class="contact" style="margin-top:2rem;display:flex;gap:1.2rem;flex-wrap:wrap;align-items:center">
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ page.url | absoluteUrl('https://belongatstpaul.org') | urlencode }}" target="_blank" rel="noopener">Share on Facebook</a>
      <a href="https://www.facebook.com/stpaulfremont" target="_blank" rel="noopener">Follow us on Facebook</a>
    </div>
    <p style="margin-top:1.6rem"><a class="btn btn-out" href="/pastors-corner/">&larr; Back to Pastor's Corner</a></p>
  </div>
</section>
