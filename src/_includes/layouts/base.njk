<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..700&family=Karla:ital,wght@0,300..700;1,300..600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
{% include "css/base.css" %}
</style>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

<!-- ========== HEADER ========== -->
<header class="topbar" id="hdr">
  <div class="wrap topbar-in">
    <a class="brandmark" href="/#top">
      <img src="/images/uploads/saint-paul-logo.png" alt="Saint Paul United Methodist Church">
    </a>
    <button class="navtoggle" id="navtoggle" aria-expanded="false" aria-controls="mainnav">Menu</button>
    <nav class="mainnav" id="mainnav">
      <a href="/#worship">Worship</a>
      <a href="/#first">About</a>
      <a href="/#week">This week</a>
      <a href="/#ministries">Ministries</a>
      <a href="/#outreach">Outreach</a>
      <a href="/#kids">Kids &amp; Youth</a>
      <a href="/#preschool">Preschool</a>
      <a href="/calendar/">Calendar</a>
      <a href="/pastors-corner/">Pastor's Corner</a>
      <a href="/#visit">Visit</a>
    </nav>
    <a class="give-btn" href="/give/">Give</a>
  </div>
</header>

{{ content | safe }}

<!-- ========== FOOTER ========== -->
<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <div class="footlogo"><img src="/images/uploads/saint-paul-logo.png" alt="Saint Paul United Methodist Church"></div>
        <p class="ft-note">United Methodist Church · Fremont, California. All are welcome, and we mean that.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="/#worship">Worship</a></li>
          <li><a href="/#first">New visitors</a></li>
          <li><a href="/#week">This week</a></li>
          <li><a href="/calendar/">Calendar</a></li>
          <li><a href="/#ministries">Ministries</a></li>
          <li><a href="/#outreach">Outreach</a></li>
          <li><a href="/#contact">Contact us</a></li>
        </ul>
      </div>
      <div>
        <h4>Community</h4>
        <ul>
          <li><a href="/#kids">Kids &amp; youth</a></li>
          <li><a href="/#preschool">Preschool</a></li>
          <li><a href="/#teams">Teams &amp; finance</a></li>
          <li><a href="/#story">Our story</a></li>
          <li><a href="/#visit">Visit</a></li>
          <li><a href="/photos/">Share photos</a></li>
        </ul>
      </div>
      <div>
        <h4>Connect</h4>
        <ul>
          <li><a href="tel:15104293990">(510) 429-3990</a></li>
          <li><a href="mailto:welcome@belongatstpaul.org">welcome@belongatstpaul.org</a></li>
          <li><a href="https://www.facebook.com/stpaulfremont" target="_blank" rel="noopener">Facebook</a></li>
          <li><a href="https://stpaulumcfremont.org/prayer-requests/" target="_blank" rel="noopener">Prayer requests</a></li>
          <li><a href="/give/">Give</a></li>
          <li><a href="/update-info/">Update your info</a></li>
          <li><a href="/pastors-corner/">Pastor's Corner</a></li>
        </ul>
      </div>
    </div>
    <div class="footbar">
      <span>33350 Peace Terrace, Fremont, CA 94555 · Sundays at 10:00 a.m.</span>
      <span>California-Nevada Annual Conference · The United Methodist Church · <a href="/admin/">Staff Login</a></span>
    </div>
  </div>
</footer>

<script>
{% include "js/main.js" %}
</script>
<script>
if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", function (user) {
    if (!user) {
      window.netlifyIdentity.on("login", function () {
        document.location.href = "/admin/";
      });
    }
  });
}
</script>
</body>
</html>
