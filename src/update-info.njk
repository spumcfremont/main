---
layout: layouts/base.njk
title: Update Your Info — St. Paul United Methodist Church
description: "Update your contact information in the Saint Paul church directory."
permalink: /update-info/
---
<section class="reveal in">
  <div class="wrap" style="max-width:640px">
    <div class="sechead">
      <p class="eyebrow">Church directory</p>
      <h2>Update <em>your info</em></h2>
      <p class="lede">Moved, got a new number, or just need to correct something? Let us know so our records stay current.</p>
    </div>
    <form id="update-info-form" method="POST" target="update-info-frame"
      action="https://docs.google.com/forms/d/e/1FAIpQLSf0T7QjStoyT9y9c-1fJwwzwkYVUoTSElPf16bkC9q2VN1vBA/formResponse">
      <div class="field">
        <label for="ui-name">Name</label>
        <input type="text" id="ui-name" name="entry.2005620554" required>
      </div>
      <div class="field">
        <label for="ui-email">Email</label>
        <input type="email" id="ui-email" name="entry.1045781291">
      </div>
      <div class="field">
        <label for="ui-address">Address</label>
        <input type="text" id="ui-address" name="entry.1065046570" required>
      </div>
      <div class="field">
        <label for="ui-phone">Phone number</label>
        <input type="tel" id="ui-phone" name="entry.1166974658">
      </div>
      <div class="field">
        <label for="ui-comments">Comments</label>
        <textarea id="ui-comments" name="entry.839337160" rows="4"></textarea>
      </div>
      <button type="submit" class="btn btn-solid">Update my info</button>
      <p id="update-info-status" class="lede" style="margin-top:1rem;display:none"></p>
    </form>
    <iframe name="update-info-frame" id="update-info-frame" style="display:none" title="form submission"></iframe>
  </div>
</section>
<script>
(function(){
  var form=document.getElementById('update-info-form');
  var frame=document.getElementById('update-info-frame');
  var status=document.getElementById('update-info-status');
  var submitted=false;
  form.addEventListener('submit',function(){submitted=true;});
  frame.addEventListener('load',function(){
    if(!submitted){return;}
    form.reset();
    form.style.display='none';
    status.textContent='Thanks — your info has been updated in our directory.';
    status.style.display='block';
  });
})();
</script>
